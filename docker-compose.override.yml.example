version: '2.0'
services:
  app:
    # Local backend only; drop these entries when the UI uses the staging backend.
    extra_hosts:
      - "${DOMAIN}:host-gateway"
      - "${VSF_API_DOMAIN}:host-gateway"
      - "${MAGENTO_DOMAIN}:host-gateway"
    #environment:
    #  - CERT_NAME=localdev
    #  - NODE_TLS_REJECT_UNAUTHORIZED=0
    ports:
      - 9229:9229
  tests:
      extra_hosts:
        - "${DOMAIN}:host-gateway"
        - "${VSF_API_DOMAIN}:host-gateway"
